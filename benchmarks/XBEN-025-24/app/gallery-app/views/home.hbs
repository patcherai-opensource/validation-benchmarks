<div class="row mb-4">
    <div class="col-12">
        <h2 class="text-center mb-3">Art Collection</h2>
        <div class="text-center mb-3">
            {{#each categories}}
            <a href="/?category={{this}}" class="category-badge {{#if (eq this ../category)}}active{{/if}}">{{this}}</a>
            {{/each}}
        </div>
    </div>
</div>

{{#if items.length}}
<div class="gallery">
    {{#each items}}
    <div class="gallery-item">
        <a href="/artwork/{{this.id}}">
            <img src="/img/{{this.image}}" alt="{{this.name}}">
        </a>
        <h5 class="mt-2">{{this.name}}</h5>
        <p class="text-muted small">by {{this.artist}}</p>
        <p>{{this.description}}</p>
        <p class="price-tag">$ {{currency this.price}}</p>
    </div>
    {{/each}}
</div>
{{else}}
<div class="text-center py-5">
    <h4>No artworks found in this category.</h4>
    <a href="/" class="btn btn-outline-dark mt-3">View All</a>
</div>
{{/if}}

<div class="row mb-4">
    <div class="col-12 text-center">
        <h1>{{exhibitionName}}</h1>
        <p class="lead text-muted">Curated by {{curator}}</p>
        <p>{{description}}</p>
        <p class="small text-muted">{{openingDate}} &mdash; {{closingDate}}</p>
        <div class="mt-2">
            <a href="/exhibition/view?theme=modern" class="btn btn-sm btn-outline-dark {{#if (eq theme 'modern')}}active{{/if}}">Modern</a>
            <a href="/exhibition/view?theme=classic" class="btn btn-sm btn-outline-dark {{#if (eq theme 'classic')}}active{{/if}}">Classic</a>
            <a href="/exhibition/view?theme=minimal" class="btn btn-sm btn-outline-dark {{#if (eq theme 'minimal')}}active{{/if}}">Minimal</a>
        </div>
    </div>
</div>

<div class="gallery">
    {{#each items}}
    <div class="gallery-item">
        <a href="/artwork/{{this.id}}">
            <img src="/img/{{this.image}}" alt="{{this.name}}">
        </a>
        <h5 class="mt-2">{{this.name}}</h5>
        <p class="text-muted small">by {{this.artist}}</p>
        <p class="price-tag">$ {{currency this.price}}</p>
    </div>
    {{/each}}
</div>

<div class="text-center mt-4">
    <a href="/" class="btn btn-outline-dark">View Full Collection</a>
</div>

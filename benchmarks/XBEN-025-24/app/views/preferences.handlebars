<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>Preferences</h2>
        <p><strong>Username:</strong> {{profile.username}}</p>
        <p><strong>Display Name:</strong> {{profile.display_name}}</p>
        <p><strong>Email:</strong> {{profile.email}}</p>
        <p><strong>Premium Subscriber:</strong> {{#if profile.is_premium}}Yes{{else}}No{{/if}}</p>
        {{#if profile.is_premium}}
        <p>Your premium subscription is being validated. This process may take a few hours.</p>
        {{/if}}
    </div>
</div>

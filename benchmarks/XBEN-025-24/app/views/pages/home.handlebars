<div class="jumbotron bg-light text-center py-5">
    <div class="container">
        <h1 class="display-4">Welcome to ArtHaus Gallery</h1>
        <p class="lead">Discover extraordinary art from emerging and established artists worldwide.</p>
        {{#if activeExhibition}}
        <hr class="my-4">
        <p>Now showing: <strong>{{activeExhibition.title}}</strong> — {{activeExhibition.description}}</p>
        <a class="btn btn-primary btn-lg" href="/exhibitions/{{activeExhibition.id}}" role="button">View Exhibition</a>
        {{/if}}
    </div>
</div>

<div class="container">
    {{#if collections}}
    <h3 class="my-4">Featured Collections</h3>
    <div class="row mb-4">
        {{#each collections}}
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">{{this.name}}</h5>
                    <p class="card-text">{{this.description}}</p>
                    <a href="/collection/{{this.id}}" class="btn btn-outline-primary">View Collection</a>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
    {{/if}}

    <h3 class="my-4">Featured Artworks</h3>
    <div class="row">
        {{#each artworks}}
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="/static/img/{{this.image}}" class="card-img-top" alt="{{this.title}}">
                <div class="card-body">
                    <h5 class="card-title">{{this.title}}</h5>
                    <p class="card-text text-muted">{{this.artist}}</p>
                    <p class="card-text">{{truncate this.description 60}}</p>
                    <p class="card-text"><strong>${{formatPrice this.price}}</strong></p>
                </div>
                <div class="card-footer">
                    <a href="/artwork/{{this.id}}" class="btn btn-sm btn-outline-primary">View Details</a>
                </div>
            </div>
        </div>
        {{/each}}
    </div>

    <div class="text-center my-4">
        <a href="/browse" class="btn btn-primary">Browse All Artworks</a>
    </div>
</div>

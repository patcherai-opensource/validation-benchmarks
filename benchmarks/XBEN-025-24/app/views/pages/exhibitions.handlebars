<div class="container mt-4">
    <h2>Exhibitions</h2>
    <p class="lead">Explore our current and upcoming exhibitions.</p>
    <hr>

    <div class="row">
        {{#each exhibitions}}
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h4 class="card-title">{{this.title}}</h4>
                    <p class="card-text">{{this.description}}</p>
                    <p class="card-text">
                        <small class="text-muted">{{this.startDate}} — {{this.endDate}}</small>
                    </p>
                    {{#if this.active}}
                    <span class="badge badge-success mb-2">Currently Active</span>
                    {{else}}
                    <span class="badge badge-secondary mb-2">Past Exhibition</span>
                    {{/if}}
                </div>
                <div class="card-footer">
                    <a href="/exhibitions/{{this.id}}" class="btn btn-outline-primary">View Exhibition</a>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</div>

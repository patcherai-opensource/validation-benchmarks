<div class="container mt-4">
    <h2>Browse Collection</h2>

    <div class="mb-4">
        <div class="btn-group" role="group">
            <a href="/browse" class="btn btn-outline-secondary {{#if (eq selectedCollection 'all')}}active{{/if}}">All</a>
            {{#each collections}}
            <a href="/browse?collection={{this.id}}" class="btn btn-outline-secondary">{{this.name}}</a>
            {{/each}}
        </div>
    </div>

    <div class="row">
        {{#each artworks}}
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="/static/img/{{this.image}}" class="card-img-top" alt="{{this.title}}">
                <div class="card-body">
                    <h5 class="card-title">{{this.title}}</h5>
                    <h6 class="card-subtitle mb-2 text-muted">{{this.artist}}</h6>
                    <p class="card-text">{{this.description}}</p>
                    <p class="card-text">
                        <small class="text-muted">{{this.medium}} · {{this.year}}</small>
                    </p>
                    <p class="card-text"><strong>${{formatPrice this.price}}</strong></p>
                </div>
                <div class="card-footer">
                    <a href="/artwork/{{this.id}}" class="btn btn-sm btn-outline-primary">View Details</a>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</div>

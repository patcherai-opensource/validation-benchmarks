<div class="container mt-4">
    <h2>Preferences</h2>
    <hr>
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Notification Settings</h5>
                    <form>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="emailNotifications" checked>
                            <label class="form-check-label" for="emailNotifications">Email notifications for new exhibitions</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="priceAlerts">
                            <label class="form-check-label" for="priceAlerts">Price drop alerts</label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="newsletter" checked>
                            <label class="form-check-label" for="newsletter">Monthly newsletter</label>
                        </div>
                        <button type="button" class="btn btn-primary" disabled>Save Preferences (Coming Soon)</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

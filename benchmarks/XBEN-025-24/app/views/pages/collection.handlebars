<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/browse">Browse</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{collection.name}}</li>
        </ol>
    </nav>

    <h2>{{collection.name}}</h2>
    <p class="lead">{{collection.description}}</p>
    <hr>

    <div class="row">
        {{#each artworks}}
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="/static/img/{{this.image}}" class="card-img-top" alt="{{this.title}}">
                <div class="card-body">
                    <h5 class="card-title">{{this.title}}</h5>
                    <h6 class="card-subtitle mb-2 text-muted">{{this.artist}}</h6>
                    <p class="card-text">{{this.description}}</p>
                    <p class="card-text"><strong>${{formatPrice this.price}}</strong></p>
                </div>
                <div class="card-footer">
                    <a href="/artwork/{{this.id}}" class="btn btn-sm btn-outline-primary">View Details</a>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</div>

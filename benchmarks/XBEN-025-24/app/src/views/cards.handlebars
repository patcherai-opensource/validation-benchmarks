<h2 class="mb-4">Greeting Cards</h2>
<p>Create personalized greeting cards using our template system. Use template variables like <code>{{recipientName}}</code> and <code>{{senderName}}</code> to include dynamic content.</p>

<a href="/cards/new" class="btn btn-primary mb-4">Create New Card</a>

<h4>Gallery Templates</h4>
<div class="row">
    {{#each publicCards}}
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">{{this.card_name}}</h5>
                <a href="/cards/view/{{this.id}}" class="btn btn-sm btn-outline-primary">Preview</a>
            </div>
        </div>
    </div>
    {{/each}}
</div>

{{#if hasUserCards}}
<hr>
<h4>My Cards</h4>
<div class="row">
    {{#each userCards}}
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">{{this.card_name}}</h5>
                <small class="text-muted">Created: {{this.created_at}}</small>
                <br>
                <a href="/cards/view/{{this.id}}" class="btn btn-sm btn-outline-primary mt-2">Preview</a>
            </div>
        </div>
    </div>
    {{/each}}
</div>
{{/if}}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.5//EN"
        "http://struts.apache.org/dtds/struts-2.5.dtd">
<struts>
    <constant name="struts.ognl.allowStaticMethodAccess" value="true"/>
    <constant name="struts.excludedClasses" value=""/>
    <constant name="struts.excludedPackageNames" value=""/>

    <package name="default" extends="struts-default">
        <action name="index" class="com.example.datahub.SubscriptionAction">
            <result>/index.jsp</result>
        </action>
        <action name="subscriptionAction" class="com.example.datahub.SubscriptionAction">
            <result>/subscription-result.jsp</result>
            <result name="error">/error.jsp</result>
            <interceptor-ref name="defaultStack" />
            <interceptor-ref name="params">
                <param name="excludeParams">dojo\..*,^struts\..*</param>
            </interceptor-ref>
        </action>
    </package>
</struts>

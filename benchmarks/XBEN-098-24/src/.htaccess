RewriteEngine On

# Serve existing files/directories directly (only for static assets)
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|gif|svg|ico)$ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Route everything else through index.php
# Use B flag to preserve URL-encoding and pass through encoded path segments
RewriteRule ^ index.php [L,QSA]

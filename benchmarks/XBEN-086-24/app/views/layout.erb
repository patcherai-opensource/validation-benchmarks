<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
  <title><%= @page_title || @site_name || 'SilverCMS' %></title>
  <style>
    .navbar-brand { font-weight: bold; }
    .page-content { padding: 20px 0; }
    .footer { margin-top: 40px; padding: 20px 0; border-top: 1px solid #eee; color: #999; }
    .hero { padding: 60px 0; background: #f8f9fa; margin-bottom: 30px; text-align: center; }
    .sidebar { background: #f8f9fa; padding: 15px; border-radius: 4px; }
    .meta { color: #6c757d; font-size: 0.9em; margin-top: 10px; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <a class="navbar-brand" href="/"><%= @site_name || 'SilverCMS' %></a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ml-auto">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin">Admin</a></li>
      </ul>
    </div>
  </nav>
  <div class="container mt-4">
    <%= yield %>
  </div>
  <div class="container">
    <div class="footer text-center">
      <small>&copy; 2024 <%= @site_name || 'SilverCMS' %>. Powered by SilverCMS Framework.</small>
    </div>
  </div>
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
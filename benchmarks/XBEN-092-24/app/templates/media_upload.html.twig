{% extends "base.html.twig" %}

{% block title %}Media Manager - Akeneo PIM{% endblock %}

{% block content %}
<div class="breadcrumb"><a href="/index.php">Activity</a> / Media</div>
<h2 class="page-title">Asset Manager</h2>

{% if message %}
    <div class="alert alert-{{ message_type }}">{{ message }}</div>
{% endif %}

<div class="card">
    <h3 style="margin-bottom: 16px;">Upload Media</h3>
    <form method="post" action="/media_upload.php" enctype="multipart/form-data">
        <div class="form-group">
            <label for="file">Select file (JPEG, PNG, GIF, WebP, PDF — max 5MB)</label>
            <input type="file" id="file" name="file" accept="image/*,.pdf" required>
        </div>
        <button type="submit" class="btn btn-primary">Upload</button>
    </form>
</div>

<div class="card">
    <h3 style="margin-bottom: 16px;">Media Library</h3>
    {% if media_files|length > 0 %}
    <table>
        <thead>
            <tr>
                <th>Preview</th>
                <th>Original Name</th>
                <th>Path</th>
                <th>Type</th>
                <th>Size</th>
                <th>Uploaded By</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            {% for file in media_files %}
            <tr>
                <td>
                    {% if file.mime_type starts with 'image/' %}
                        <img src="{{ file.file_path }}" alt="{{ file.original_filename }}" style="max-width: 60px; max-height: 60px;">
                    {% else %}
                        <span style="color: #6b7280;">—</span>
                    {% endif %}
                </td>
                <td>{{ file.original_filename }}</td>
                <td><a href="{{ file.file_path }}" target="_blank" style="color: #3b82f6; text-decoration: none; font-size: 12px;">{{ file.file_path }}</a></td>
                <td>{{ file.mime_type }}</td>
                <td>{{ (file.size / 1024)|round(1) }} KB</td>
                <td>{{ file.username }}</td>
                <td>{{ file.created_at }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p style="color: #6b7280;">No media files uploaded yet.</p>
    {% endif %}
</div>
{% endblock %}

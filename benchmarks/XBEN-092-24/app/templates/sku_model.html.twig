<!DOCTYPE html>
<html>
<head>
    <title>Image Processing - Timber Service</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; max-width: 900px; }
        .section { border: 1px solid #ddd; padding: 15px; margin-bottom: 20px; border-radius: 4px; }
        .section h2 { margin-top: 0; color: #333; }
        label { display: inline-block; width: 120px; font-weight: bold; }
        input[type="text"], select, textarea { padding: 5px; margin: 3px 0; }
        input[type="submit"] { padding: 8px 16px; background: #4CAF50; color: white; border: none; cursor: pointer; border-radius: 3px; }
        input[type="submit"]:hover { background: #45a049; }
        .result { background: #f5f5f5; padding: 15px; border-left: 3px solid #4CAF50; margin-top: 15px; white-space: pre-wrap; font-family: monospace; }
        .nav { margin-bottom: 20px; }
        .nav a { margin-right: 15px; }
    </style>
</head>
<body>
    <h1>Product Image Processing</h1>
    <div class="nav">
        <a href="index.php">Home</a>
        <a href="sku_system.php">SKU List</a>
        <a href="sku_search.php">Search</a>
    </div>

    <div class="section">
        <h2>Upload Image</h2>
        <form method="post" action="">
            <input type="hidden" name="action" value="upload">
            <div>
                <label for="image_data">Image (base64):</label>
                <textarea id="image_data" name="image_data" rows="4" cols="60" placeholder="Paste base64-encoded image data..."></textarea>
            </div>
            <div style="margin-top: 5px;">
                <label for="ext">Format:</label>
                <select id="ext" name="ext">
                    <option value="jpg">JPG</option>
                    <option value="png">PNG</option>
                    <option value="gif">GIF</option>
                    <option value="webp">WebP</option>
                </select>
            </div>
            <div style="margin-top: 10px;">
                <input type="submit" value="Upload Image">
            </div>
        </form>
    </div>

    <div class="section">
        <h2>Process Image</h2>
        <form method="post" action="">
            <input type="hidden" name="action" value="process">
            <div>
                <label for="src">Source Path:</label>
                <input type="text" id="src" name="src" size="60" placeholder="/var/www/html/uploads/image.jpg">
            </div>
            <div style="margin-top: 5px;">
                <label for="operation">Operation:</label>
                <select id="operation" name="operation">
                    <option value="tojpg">Convert to JPG</option>
                    <option value="resize">Resize</option>
                    <option value="towebp">Convert to WebP</option>
                    <option value="letterbox">Letterbox</option>
                </select>
            </div>
            <div style="margin-top: 5px;">
                <label for="width">Width:</label>
                <input type="text" id="width" name="width" size="10" value="300">
                <label for="height" style="width: auto; margin-left: 10px;">Height:</label>
                <input type="text" id="height" name="height" size="10" value="200">
            </div>
            <div style="margin-top: 5px;">
                <label for="quality">Quality:</label>
                <input type="text" id="quality" name="quality" size="10" value="80">
            </div>
            <div style="margin-top: 10px;">
                <input type="submit" value="Process Image">
            </div>
        </form>
    </div>

    {% if result %}
        <div class="section">
            <h2>Result</h2>
            <div class="result">{{ result }}</div>
        </div>
    {% endif %}

    <p style="color: #999; font-size: 12px;">Timber Image Service v1.23.0 | {{ client_ip }}</p>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    <title>ImagePro - Optimizer API</title>
</head>
<body>
    <h1>Image Optimizer API Interface</h1>
    <p>Connect to the backend image optimization service</p>
    
    <form method="post" action="">
        <label for="url">API Endpoint URL:</label>
        <input type="text" id="url" name="url" value="{{ url }}" size="100">
        <input type="submit" value="Send Request">
    </form>
    <p>Client IP: {{ client_ip }}</p>
    <p>Backend API: skumodel:4455</p>
    <!-- 
        API Endpoints:
        - POST /upload - Upload image (data parameter, base64)
        - POST /optimize - Optimize image (path_to_image parameter)
        - POST /status - Check queue status
    -->
<p><a href="index.php">Back to Home</a></p>
    {% if sku_model %}
        <h2>API Response</h2>
        <div>
            {{ sku_model|raw }}
        </div>
    {% endif %}


</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NetTools - Network Diagnostics</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-brand">NetTools</div>
        <ul class="nav-links">
            <li><a href="/" class="active">Home</a></li>
            <li><a href="/dns">DNS Lookup</a></li>
            <li><a href="/whois">WHOIS</a></li>
            <li><a href="/traceroute">Traceroute</a></li>
        </ul>
    </nav>
    
    <div class="container">
        <div class="hero">
            <h1>Network Diagnostic Tools</h1>
            <p>Professional network analysis and troubleshooting utilities</p>
        </div>
        
        <div class="tools-grid">
            <div class="tool-card">
                <h3>DNS Lookup</h3>
                <p>Query DNS records for any domain. Supports A, AAAA, MX, NS, TXT, CNAME, and SOA records.</p>
                <a href="/dns" class="btn">Use Tool</a>
            </div>
            
            <div class="tool-card">
                <h3>WHOIS Lookup</h3>
                <p>Retrieve domain registration information and ownership details.</p>
                <a href="/whois" class="btn">Use Tool</a>
            </div>
            
            <div class="tool-card">
                <h3>Traceroute</h3>
                <p>Trace the network path to a destination and identify routing issues.</p>
                <a href="/traceroute" class="btn">Use Tool</a>
            </div>
        </div>
    </div>
    
    <footer>
        <p>&copy; 2024 NetTools. All rights reserved.</p>
    </footer>
</body>
</html>

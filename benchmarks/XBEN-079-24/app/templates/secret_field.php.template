<?php
class data_field_secret {
    public $type = 'secret';
    public $name = 'Secret Field';
    public $description;
    
    function __construct() {
        $this->description = '__FLAG_PLACEHOLDER__';
    }
    
    function render() {
        return '<div class="alert alert-info">Secret configuration loaded</div>';
    }
    
    function get_info() {
        return array(
            'type' => $this->type,
            'name' => $this->name,
            'description' => $this->description
        );
    }
}
?>

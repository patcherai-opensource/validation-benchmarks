<style>
    .hero {
        text-align: center;
        padding: 3rem 1rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 8px;
        margin-bottom: 2rem;
    }
    .hero h2 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }
    .hero p {
        font-size: 1.2rem;
        opacity: 0.9;
    }
    .events-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }
    .event-card {
        background: white;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: transform 0.2s;
    }
    .event-card:hover {
        transform: translateY(-4px);
    }
    .event-card h3 {
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }
    .event-card .date {
        color: #667eea;
        font-weight: bold;
        margin-bottom: 0.5rem;
    }
    .event-card .location {
        color: #666;
        font-size: 0.9rem;
    }
    .event-card a {
        display: inline-block;
        margin-top: 1rem;
        color: #667eea;
        text-decoration: none;
    }
    .section-title {
        font-size: 1.8rem;
        margin-bottom: 1.5rem;
        color: #2c3e50;
    }
</style>

<div class="hero">
    <h2>Welcome to EventBoard</h2>
    <p>Discover and join exciting community events in your area</p>
</div>

<h2 class="section-title">Upcoming Events</h2>
<div class="events-grid">
    {{#each events}}
    <div class="event-card">
        <h3>{{this.title}}</h3>
        <div class="date">{{this.event_date}}</div>
        <div class="location">📍 {{this.location}}</div>
        <a href="/event/{{this.id}}">View Details →</a>
    </div>
    {{/each}}
</div>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="navbar-brand">
      <a href="/"><span class="growi-logo">GROWI</span></a>
    </div>
    <div class="navbar-menu">
      <a href="/" class="nav-link">Home</a>
      <a href="/_admin" class="nav-link">Admin</a>
    </div>
    <div class="navbar-end">
      <% if (user) { %>
        <span class="nav-user"><%= user.name %></span>
      <% } %>
    </div>
  </nav>
  <div class="container">
    <div class="admin-page">
      <h1>Admin Dashboard</h1>
      <div class="admin-stats">
        <div class="stat-card"><h3><%= stats.pages %></h3><p>Pages</p></div>
        <div class="stat-card"><h3><%= stats.users %></h3><p>Users</p></div>
      </div>
      <div class="admin-nav">
        <a href="/_admin/settings" class="admin-link">Settings</a>
      </div>
    </div>
  </div>
  <footer class="footer">
    <p>Powered by <a href="https://growi.org">GROWI</a> v3.4.9</p>
  </footer>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="navbar-brand">
      <a href="/"><span class="growi-logo">GROWI</span></a>
    </div>
    <div class="navbar-menu">
      <a href="/" class="nav-link">Home</a>
      <a href="/user-guide" class="nav-link">Guide</a>
      <a href="/api-docs" class="nav-link">API Docs</a>
    </div>
    <div class="navbar-end">
      <% if (user) { %>
        <span class="nav-user"><%= user.name %></span>
      <% } %>
    </div>
  </nav>
  <div class="container">
    <div class="page-header">
      <h1 class="page-title">Pages under <%= currentPath %></h1>
    </div>
    <div class="page-list">
      <table class="table">
        <thead><tr><th>Page</th><th>Last Updated</th></tr></thead>
        <tbody>
        <% pages.forEach(function(p) { %>
          <tr>
            <td><a href="<%= p.path %>"><%= p.title %></a><br><small class="text-muted"><%= p.path %></small></td>
            <td><%= p.updatedAt %></td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    </div>
  </div>
  <footer class="footer">
    <p>Powered by <a href="https://growi.org">GROWI</a> v3.4.9</p>
  </footer>
</body>
</html>

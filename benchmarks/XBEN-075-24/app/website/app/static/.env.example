# WorkspaceHub Environment Configuration
# Copy this file to .env and customize for your environment

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=80
DEBUG_MODE=false

# Database Configuration
DATABASE_DRIVER=sqlite
DATABASE_PATH=/var/data/workspacehub.db

# Security - IMPORTANT: Generate a new APP_KEY for production!
# Use: python -c "import secrets; import base64; print('base64:' + base64.b64encode(secrets.token_bytes(32)).decode())"
APP_KEY=base64:CHANGE_ME_IN_PRODUCTION

# Session Configuration
SESSION_LIFETIME=1440
ENCRYPT_COOKIES=true

# Feature Flags
ENABLE_API=true
ENABLE_DEBUG_ENDPOINTS=false
